# DyeFresh × SanMar Proxy — Environment Variables
# Copy this file to .env for local testing, or set these in Railway/Render dashboard

# SanMar credentials (from sanmarintegrations@sanmar.com)
SANMAR_CUSTOMER_NUMBER=your_customer_number_here
SANMAR_USERNAME=your_sanmar_username_here
SANMAR_PASSWORD=your_sanmar_password_here

# Allowed origins for CORS (comma-separated, no spaces)
ALLOWED_ORIGINS=https://dyefresh.com,https://jcampos13.github.io

# Port (Railway/Render set this automatically)
PORT=3000
